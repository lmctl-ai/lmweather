# Rossby-Haurwitz wave 4 (Williamson test case 6) after 7 days at T21: geopotential height in metres on a longitude-latitude map.
# Two hosts in one script: lmweather integrates the model and writes a CSV, lmplot (gnuplot in a static binary) draws it.
# Needs lmplot on PATH or installable; the PNG lands in build/examples/rh_wave_plot.png.
mkdir("build/examples");
sim = _dsl_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";

let s = wx.sphere(21).williamson6();
s.run_dt(7.0 * 86400.0, 1800.0);
s.save_csv("build/examples/rh_wave_plot.csv");
end _dsl_
savedsl(sim, "build/rh_wave_plot-sim.dslb");
r = system ${dsl_cli(sim)} --dsl build/rh_wave_plot-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("build/examples/rh_wave_plot.png", 1000, 600);
plot.cmd("set title 'Rossby-Haurwitz wave 4, day 7: height [m] (lmweather T21, drawn by lmplot)'");
plot.cmd("set xlabel 'longitude'");
plot.cmd("set ylabel 'latitude'");
plot.cmd("set xrange [0:360]");
plot.cmd("set yrange [-90:90]");
plot.cmd("set pm3d map");
plot.cmd("set palette rgbformula 33,13,10");
plot.cmd("unset key");
plot.cmd("splot 'build/examples/rh_wave_plot.csv' using 1:2:3 with pm3d");
plot.close();
end _dsl_
savedsl(draw, "build/rh_wave_plot-draw.dslb");
r = system ${dsl_cli(draw)} --dsl build/rh_wave_plot-draw.dslb;
assert(r.code == 0);
println("wrote build/examples/rh_wave_plot.png");
