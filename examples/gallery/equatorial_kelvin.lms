# Equatorial wave guide (Matsuno-Gill / ENSO warm-pool thermocline pulse): an initial Gaussian height anomaly on the
# equator (f0 = 0, beta = 2.28e-11) splits asymmetrically into a fast eastward-propagating equatorial Kelvin wave
# trapped on the equator at c = sqrt(g H) and a slower pair of westward n = 1 equatorial Rossby lobes off the equator.
# lmweather integrates the equatorial beta-plane; lmplot draws images/equatorial_kelvin.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let lx = 24000000.0;
let ly = 8000000.0;
let m = wx.plane(160, 64, lx, ly).depth(200.0).coriolis(0.0, 0.0000000000228).linear();
let c = m.wave_speed();
wx.print("equatorial gravity speed c = " + str(c) + " m/s");
# Warm-pool thermocline bump of 10 m centered at x0 = 10 000 km on the equator y = ly/2
m.fields("10.0 * pow(2.718281828459045, -(x - 10000000.0) * (x - 10000000.0) / 1800000000000.0 - (y - ly / 2.0) * (y - ly / 2.0) / 900000000000.0)", "0", "0");
m.run(150000.0);
m.save_csv("data/kelvin_2d.csv");
let slices = "";
for (i in range(0, 160)) {
  let x = (float(i) + 0.5) * lx / 160.0;
  let h_eq = m.h_at(x, 0.5 * ly) - 200.0;
  let h_off = m.h_at(x, 0.5 * ly + 1350000.0) - 200.0;
  slices = slices + str((x - 10000000.0) / 1000.0) + " " + str(h_eq) + " " + str(h_off) + "\n";
}
wx.save_text("data/kelvin_slices.csv", slices);
# Eastward Kelvin peak on the equator sits near x0 + c*t; westward Rossby lobe off-equator sits west of x0
let h_kelvin = m.h_at(10000000.0 + c * 150000.0, 0.5 * ly) - 200.0;
let h_rossby = 0.0;
for (i in range(0, 70)) {
  let x = (float(i) + 0.5) * lx / 160.0;
  let hr = m.h_at(x, 0.5 * ly + 1350000.0) - 200.0;
  if (hr > h_rossby) { h_rossby = hr; }
}
wx.print("Kelvin crest on equator: " + str(h_kelvin) + " m; Rossby lobe max at 1350 km N: " + str(h_rossby) + " m");
wx.assert_true(h_kelvin > 3.0);
wx.assert_true(h_rossby > 1.0);
end _lmcode_
savedsl(sim, "data/equatorial_kelvin-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/equatorial_kelvin-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/equatorial_kelvin.png", 900, 580);
plot.cmd("set multiplot layout 2,1");
plot.cmd("set border 3; set tics nomirror");
plot.cmd("set title 'Equatorial beta-plane after 41.7 h: eastward Kelvin packet on equator, westward Rossby lobes'");
plot.cmd("set xlabel 'distance from initial pulse x - x_0 [km]'; set ylabel 'y - y_{eq} [km]'");
plot.cmd("set xrange [-8000:11000]; set yrange [-3800:3800]");
plot.cmd("set palette defined (-1.5 '#2166ac', 0 '#f7f7f7', 2 '#fddbc7', 4.5 '#b2182b')");
plot.cmd("set cbrange [-1.5:4.5]; set cblabel 'h - H [m]'");
plot.cmd("plot 'data/kelvin_2d.csv' u (($1-10000000.0)/1000.0):(($2-4000000.0)/1000.0):($3-200.0) with image notitle");
plot.cmd("unset cblabel; set grid lc rgb '#dddddd'; set key top left box opaque");
plot.cmd("set title 'Zonal slices: non-dispersive Kelvin wave at +c t vs slower off-equatorial Rossby wave'");
plot.cmd("set xlabel 'x - x_0 [km]'; set ylabel 'h - H [m]'; set xrange [-8000:11000]; set yrange [-1.6:5.2]");
plot.cmd("plot 0 w l lw 1 lc rgb '#cccccc' notitle, 'data/kelvin_slices.csv' u 1:2 w l lw 2.6 lc rgb '#b2182b' t 'equator (y = 0): Kelvin wave', '' u 1:3 w l lw 2.4 lc rgb '#2166ac' t 'off-equator (y = +1350 km): Rossby lobe'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/equatorial_kelvin-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/equatorial_kelvin-draw.dslb;
assert(r.code == 0);
println("wrote images/equatorial_kelvin.png");
