# Westward Rossby wave dispersion on a mid-latitude beta-plane channel: planetary vorticity advection (-beta v)
# drives crests westward at c_p = -beta / (k^2 + l^2 + 1/Ld^2).
# lmweather integrates the beta-plane channel for 12 days; lmplot draws images/rossby_wave.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let pi = 3.141592653589793;
let lx = 4000000.0;
let ly = 2000000.0;
let beta = 0.00000000002;
let m = wx.plane(80, 40, lx, ly).depth(1000.0).coriolis(0.0001, beta).linear();
let k = 2.0 * pi / lx;
let l = pi / ly;
let ld = m.rossby_radius();
let cp = -beta / (k * k + l * l + 1.0 / (ld * ld));
wx.print("Rossby phase speed c_p = " + str(cp) + " m/s (" + str(cp * 86.4) + " km/day)");
m.fields("0.0001 * 100000.0 * cos(2 * pi * x / lx) * sin(pi * y / ly) / g", "-100000.0 * pi / ly * cos(2 * pi * x / lx) * cos(pi * y / ly)", "-100000.0 * 2 * pi / lx * sin(2 * pi * x / lx) * sin(pi * y / ly)");
let c0 = m.zonal_crest(1, 20);
m.save_row(20, "data/rossby_row0.csv");
m.run(4.0 * 86400.0);
m.save_row(20, "data/rossby_row4.csv");
m.run(4.0 * 86400.0);
m.save_row(20, "data/rossby_row8.csv");
m.run(2.0 * 86400.0);
m.save_csv("data/rossby_day10.csv");
let shift = m.zonal_crest(1, 20) - c0;
let diff = shift - cp * 864000.0;
diff = diff - floor(diff / lx + 0.5) * lx;
wx.assert_close(diff, 0.0, 50000.0);
end _lmcode_
savedsl(sim, "data/rossby_wave-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/rossby_wave-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/rossby_wave.png", 900, 580);
plot.cmd("set multiplot layout 2,1");
plot.cmd("set border 3; set tics nomirror");
plot.cmd("set title 'Beta-plane Rossby wave at day 10: height anomaly h - H [m]'");
plot.cmd("set xlabel 'x [km]'; set ylabel 'y [km]'; set xrange [0:4000]; set yrange [0:2000]");
plot.cmd("set palette rgbformulae 33,13,10; set cblabel 'h - H [m]'");
plot.cmd("plot 'data/rossby_day10.csv' u ($1/1000.0):($2/1000.0):($3-1000.0) with image notitle");
plot.cmd("unset cblabel; set grid lc rgb '#dddddd'; set key top right horizontal box opaque");
plot.cmd("set title 'Westward phase propagation along channel midline y = L_y / 2 (c_p = -3.77 m/s)'");
plot.cmd("set xlabel 'x [km]'; set ylabel 'h - H [m]'; set xrange [0:4000]; set yrange [-1.3:1.45]");
plot.cmd("plot 'data/rossby_row0.csv' u ($1/1000.0):($2-1000.0) w l lw 2.4 lc rgb '#1f77b4' t 'day 0', 'data/rossby_row4.csv' u ($1/1000.0):($2-1000.0) w l lw 2.4 lc rgb '#2ca02c' t 'day 4', 'data/rossby_row8.csv' u ($1/1000.0):($2-1000.0) w l lw 2.4 lc rgb '#d62728' t 'day 8'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/rossby_wave-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/rossby_wave-draw.dslb;
assert(r.code == 0);
println("wrote images/rossby_wave.png");
