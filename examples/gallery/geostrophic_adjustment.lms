# Rossby geostrophic adjustment in a rotating channel: a 1 m Gaussian height ridge released from rest radiates
# inertia-gravity (Poincare) waves and settles into geostrophic balance, where the Coriolis force on a pair of
# opposing zonal jets balances the pressure gradient and potential vorticity predicts the final profile.
# lmweather integrates the f-plane channel; lmplot draws images/geostrophic_adjustment.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let pi = 3.141592653589793;
let ly = 4000000.0;
let ny = 200;
let m = wx.plane(8, ny, 40000.0, ly).depth(1000.0).coriolis(0.0001, 0.0).linear();
m.fields("pow(2.718281828459045, -(y - ly / 2) * (y - ly / 2) / 160000000000.0)", "0", "0");
let ld = m.rossby_radius();
let q0 = m.pv_anomaly_rms();
let tin = 2.0 * pi / 0.0001;

m.run(0.35 * tin);
let snap_h = "";
for (j in range(0, ny)) {
  let yy = (float(j) + 0.5) * ly / float(ny);
  snap_h = snap_h + str((yy - 0.5 * ly) / 1000.0) + " " + str(m.h_at(20000.0, yy) - 1000.0) + "\n";
}
wx.save_text("data/adjust_radiating.csv", snap_h);

m.run(4.65 * tin);
let avg_center = 0.0;
for (s in range(0, 80)) {
  m.run(tin / 8.0);
  avg_center = avg_center + m.h_at(20000.0, 0.5 * ly) - 1000.0;
}
avg_center = avg_center / 80.0;

# Exact PV-conserving balanced profile h_bal(y) and geostrophic wind u_bal(y) = -(g/f0) dh_bal/dy from cosine series
let prof = "";
let pred_center = 0.0;
for (j in range(0, ny)) {
  let yy = (float(j) + 0.5) * ly / float(ny);
  let init_h = pow(2.718281828459045, -(yy - ly / 2.0) * (yy - ly / 2.0) / 160000000000.0);
  let h_bal = 0.0;
  let u_bal = 0.0;
  for (n in range(0, 40)) {
    let c = 0.0;
    for (jj in range(0, ny)) {
      let y2 = (float(jj) + 0.5) * ly / float(ny);
      c = c + pow(2.718281828459045, -(y2 - ly / 2.0) * (y2 - ly / 2.0) / 160000000000.0) * cos(float(n) * pi * (float(jj) + 0.5) / float(ny));
    }
    let norm = 2.0 / float(ny);
    if (n == 0) { norm = 1.0 / float(ny); }
    let kk = float(n) * pi / ly;
    let amp = c * norm / (1.0 + kk * kk * ld * ld);
    h_bal = h_bal + amp * cos(kk * yy);
    u_bal = u_bal + (9.80616 / 0.0001) * kk * amp * sin(kk * yy);
  }
  if (j == ny / 2) { pred_center = h_bal; }
  prof = prof + str((yy - 0.5 * ly) / 1000.0) + " " + str(init_h) + " " + str(h_bal) + " " + str(u_bal * 100.0) + "\n";
}
wx.save_text("data/adjust_profiles.csv", prof);
wx.print("center height: simulated " + str(avg_center) + " m, PV prediction " + str(pred_center) + " m");
wx.assert_close(avg_center, pred_center, 0.01);
wx.assert_close(m.pv_anomaly_rms() / q0, 1.0, 0.001);
end _lmcode_
savedsl(sim, "data/geostrophic_adjustment-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/geostrophic_adjustment-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/geostrophic_adjustment.png", 920, 480);
plot.cmd("set multiplot layout 1,2");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set title 'Height adjustment across channel'; set xlabel 'y - y_0 [km]'; set ylabel 'height anomaly h - H [m]'");
plot.cmd("set xrange [-2000:2000]; set yrange [-0.05:1.05]; set key top right box opaque");
plot.cmd("plot 'data/adjust_profiles.csv' u 1:2 w l lw 2.2 dt 2 lc rgb '#666666' t 'initial ridge (t = 0)', 'data/adjust_radiating.csv' u 1:2 w l lw 2 lc rgb '#ff7f0e' t 'radiating Poincare wave', 'data/adjust_profiles.csv' u 1:3 w l lw 2.8 lc rgb '#1f77b4' t 'PV-balanced state'");
plot.cmd("set title 'Balanced geostrophic jets u(y)'; set xlabel 'y - y_0 [km]'; set ylabel 'zonal wind u [cm/s]'");
plot.cmd("set xrange [-2000:2000]; set yrange [-2.8:2.8]; set key top right box opaque");
plot.cmd("plot 0 w l lw 1 lc rgb '#999999' notitle, 'data/adjust_profiles.csv' u 1:4 w l lw 2.8 lc rgb '#d62728' t 'u(y) = -(g/f_0) dh/dy'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/geostrophic_adjustment-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/geostrophic_adjustment-draw.dslb;
assert(r.code == 0);
println("wrote images/geostrophic_adjustment.png");
