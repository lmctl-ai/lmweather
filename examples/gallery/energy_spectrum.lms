# Decaying turbulence on the rotating sphere and its kinetic-energy spectrum. A random height field (wavenumbers up to
# 20) on a 6000 m layer adjusts into vortices; the nonlinear terms cascade enstrophy to small scales, where del^4
# hyperdiffusion removes it. The spectrum by total wavenumber n steepens from the flat initial forcing range into the
# enstrophy-cascade slope n^-3 of two-dimensional turbulence (Kraichnan 1967) before the dissipation range. T63 for 6 days.
# lmweather integrates the spectral model and writes the spectra; lmplot draws images/energy_spectrum.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let s = wx.sphere(42).fields("6000.0", "0", "0").perturb(600.0, 5, 10).diffusion(100000000000000.0);
let e0 = s.energy();
s.run_dt(0.5 * 86400.0, 600.0);
s.save_spectrum("data/spectrum_h12.csv");
let k1 = s.kinetic_energy();
s.run_dt(1.5 * 86400.0, 600.0);
s.save_spectrum("data/spectrum_d2.csv");
s.run_dt(6.0 * 86400.0, 600.0);
s.save_spectrum("data/spectrum_d8.csv");
s.save_csv("data/turbulence_d8.csv");
wx.print("kinetic energy: 12 h " + str(k1) + ", day 8 " + str(s.kinetic_energy()) + " J/m2; max wind " + str(s.max_wind()) + " m/s; total energy lost to hyperdiffusion: " + str(1.0 - s.energy() / e0));
wx.assert_true(s.energy() < e0);
wx.assert_true(s.max_wind() > 20.0);
end _lmcode_
savedsl(sim, "data/energy_spectrum-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/energy_spectrum-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/energy_spectrum.png", 1000, 480);
plot.cmd("set multiplot layout 1,2 title 'Decaying shallow-water turbulence at T42: vortices and the n^{-3} enstrophy cascade' font ',13'");
plot.cmd("set pm3d map; unset key; set xrange [0:360]; set yrange [-90:90]; set xtics 90; set ytics 45");
plot.cmd("set palette defined (-8 '#2166ac', 0 '#f7f7f7', 8 '#b2182b'); set cbrange [-8:8]; set cblabel 'relative vorticity [10^{-5} s^{-1}]'");
plot.cmd("set title 'relative vorticity at day 8'; set xlabel 'longitude [deg]'; set ylabel 'latitude [deg]'");
plot.cmd("splot 'data/turbulence_d8.csv' u 1:2:($6*100000.0) w pm3d");
plot.cmd("unset pm3d; unset cblabel; set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set key bottom left box opaque");
plot.cmd("set title 'kinetic-energy spectrum by total wavenumber n'; set xlabel 'n'; set ylabel 'E(n) [m^2 s^{-2}]'; set logscale xy; set xrange [1:42]; set yrange [0.01:100]; set format y '10^{%T}'; set xtics (1,2,5,10,20,42)");
plot.cmd("set label 1 'n^{-3}' at 22, 1.2 tc rgb '#999999' font ',11'");
plot.cmd("plot 'data/spectrum_h12.csv' u 1:2 w lp lw 2 pt 7 ps 0.8 lc rgb '#9ecae1' t 'hour 12 (forced n <= 10)', 'data/spectrum_d2.csv' u 1:2 w lp lw 2 pt 7 ps 0.8 lc rgb '#4292c6' t 'day 2', 'data/spectrum_d8.csv' u 1:2 w lp lw 2.5 pt 7 ps 0.9 lc rgb '#08306b' t 'day 8', 6000.0 * x ** -3 w l lw 1.5 dt 2 lc rgb '#999999' notitle");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/energy_spectrum-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/energy_spectrum-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/energy_spectrum.png");
