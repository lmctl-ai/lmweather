# Spherical-harmonic gravity modes (Laplace tidal oscillations on a non-rotating sphere): each spherical harmonic Y_n^m
# oscillates at the exact normal-mode frequency omega_n = sqrt(n (n + 1) g H) / a, so higher degree n rings faster.
# lmweather integrates modes n = 1, 2, 3, 4 and checks them against cos(omega_n t); lmplot draws images/spherical_modes.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let a = 6371220.0;
let g = 9.80616;
let hh = 10000.0;
let c = sqrt(g * hh) / a;
let s1 = wx.planet(21, a, 0.0, g).mode(1, 0, 10.0, hh);
let s2 = wx.planet(21, a, 0.0, g).mode(2, 0, 10.0, hh);
let s3 = wx.planet(21, a, 0.0, g).mode(3, 0, 10.0, hh);
let s4 = wx.planet(21, a, 0.0, g).mode(4, 0, 10.0, hh);
let a10 = s1.mode_coefficient(1, 0, "re");
let a20 = s2.mode_coefficient(2, 0, "re");
let a30 = s3.mode_coefficient(3, 0, "re");
let a40 = s4.mode_coefficient(4, 0, "re");
let w1 = sqrt(2.0) * c;
let w2 = sqrt(6.0) * c;
let w3 = sqrt(12.0) * c;
let w4 = sqrt(20.0) * c;

let pts = "";
let curves = "";
let worst = 0.0;
for (k in range(0, 121)) {
  let t = 720.0 * float(k);
  let hr = t / 3600.0;
  let e1 = cos(w1 * t);
  let e2 = cos(w2 * t);
  let e3 = cos(w3 * t);
  let e4 = cos(w4 * t);
  curves = curves + str(hr) + " " + str(e1) + " " + str(e2) + " " + str(e3) + " " + str(e4) + "\n";
  if (k - (k / 4) * 4 == 0) {
    let n1 = s1.mode_coefficient(1, 0, "re") / a10;
    let n2 = s2.mode_coefficient(2, 0, "re") / a20;
    let n3 = s3.mode_coefficient(3, 0, "re") / a30;
    let n4 = s4.mode_coefficient(4, 0, "re") / a40;
    pts = pts + str(hr) + " " + str(n1) + " " + str(n2) + " " + str(n3) + " " + str(n4) + "\n";
    worst = max(worst, abs(n1 - e1));
    worst = max(worst, abs(n2 - e2));
    worst = max(worst, abs(n3 - e3));
    worst = max(worst, abs(n4 - e4));
  }
  s1.run_dt(720.0, 360.0);
  s2.run_dt(720.0, 360.0);
  s3.run_dt(720.0, 360.0);
  s4.run_dt(720.0, 360.0);
}
wx.save_text("data/modes_exact.csv", curves);
wx.save_text("data/modes_sim.csv", pts);
wx.print("worst modal amplitude error over 24 h: " + str(worst));
wx.assert_close(worst, 0.0, 0.002);
end _lmcode_
savedsl(sim, "data/spherical_modes-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/spherical_modes-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/spherical_modes.png", 920, 500);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set title 'Spherical-harmonic gravity modes Y_n^0: spectral simulation (dots) vs cos(sqrt(n(n+1) g H)/a * t)'");
plot.cmd("set xlabel 'time [hours]'; set ylabel 'normalized modal amplitude c_n(t) / c_n(0)'");
plot.cmd("set xrange [0:24]; set xtics 4; set yrange [-1.15:1.35]; set key top right horizontal box opaque");
plot.cmd("plot 'data/modes_exact.csv' u 1:2 w l lw 2 lc rgb '#1f77b4' t 'n = 1', 'data/modes_sim.csv' u 1:2 w p pt 7 ps 1.1 lc rgb '#1f77b4' notitle, 'data/modes_exact.csv' u 1:3 w l lw 2 lc rgb '#2ca02c' t 'n = 2', 'data/modes_sim.csv' u 1:3 w p pt 7 ps 1.1 lc rgb '#2ca02c' notitle, 'data/modes_exact.csv' u 1:4 w l lw 2 lc rgb '#ff7f0e' t 'n = 3', 'data/modes_sim.csv' u 1:4 w p pt 7 ps 1.1 lc rgb '#ff7f0e' notitle, 'data/modes_exact.csv' u 1:5 w l lw 2 lc rgb '#d62728' t 'n = 4', 'data/modes_sim.csv' u 1:5 w p pt 7 ps 1.1 lc rgb '#d62728' notitle");
plot.close();
end _lmcode_
savedsl(draw, "data/spherical_modes-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/spherical_modes-draw.dslb;
assert(r.code == 0);
println("wrote images/spherical_modes.png");
