# Geostrophic adjustment as a design study: how much of an initial height ridge survives depends on its width L
# compared with the Rossby deformation radius Ld = sqrt(g H) / f. A narrow ridge (L << Ld) radiates nearly all of its
# energy away as inertia-gravity waves and leaves a flat, weak balanced state; a wide one (L >> Ld) hardly moves and stays
# in place with a geostrophic jet along it. Linear theory fixes the end state from potential-vorticity conservation:
# in cosine modes h_n -> h_n / (1 + (n pi Ld / Ly)^2). Six channel runs (f0 = 1e-4, H = 1000 m, Ld = 990 km) measure the
# surviving height at the ridge centre as a 10-inertial-period time mean and compare with that prediction.
# lmweather integrates the linear C-grid channel; lmplot draws images/adjustment_width.png.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmweather" install="github:lmctl-ai/lmweather@latest";
let pi = 3.141592653589793;
let ny = 200;                                              # 40 km cells across the 8000 km channel
let ly = 8000000.0;
let f0 = 0.0001;
let tin = 2.0 * pi / f0;
let rows = "";
for (i in range(0, 5)) {
  let ratio = 0.25 * pow(2.0, float(i));                  # L / Ld = 0.25 .. 4
  let m = wx.plane(4, ny, 160000.0, ly).depth(1000.0).coriolis(f0, 0.0).linear();
  let ld = m.rossby_radius();
  let L = ratio * ld;
  let L2 = str(L * L);
  m.fields("pow(e, -(y - ly / 2) * (y - ly / 2) / " + L2 + ")", "0", "0");
  m.run(5.0 * tin);
  let acc = 0.0;
  for (k in range(0, 80)) {                                # time mean over 10 inertial periods
    m.run(tin / 8.0);
    acc = acc + m.h_at(80000.0, 0.5 * ly) - 1000.0;
  }
  let sim_center = acc / 80.0;
  # potential-vorticity prediction at the centre, and the fraction of the initial energy kept by the balanced state
  let dy = ly / float(ny);
  let pred = 0.0;
  let kept = 0.0;
  let total = 0.0;
  for (n in range(0, ny)) {
    let c = 0.0;
    for (j in range(0, ny)) {
      let yy = (float(j) + 0.5) * dy;
      c = c + pow(2.718281828459045, -(yy - ly / 2.0) * (yy - ly / 2.0) / (L * L)) * cos(float(n) * pi * (float(j) + 0.5) / float(ny));
    }
    let norm = 2.0 / float(ny);
    let wgt = 0.5;
    if (n == 0) { norm = 1.0 / float(ny); wgt = 1.0; }
    c = c * norm;
    let kk = float(n) * pi / ly;
    let damp = 1.0 / (1.0 + kk * kk * ld * ld);
    pred = pred + c * damp * cos(float(n) * pi * 0.5);
    total = total + wgt * c * c;
    kept = kept + wgt * c * c * damp;
  }
  rows = rows + str(ratio) + " " + str(sim_center) + " " + str(pred) + " " + str(kept / total) + " " + str(m.max_speed()) + "\n";
  wx.print("L/Ld = " + str(ratio) + ": centre height kept " + str(sim_center) + " (theory " + str(pred) + "), energy fraction kept " + str(kept / total) + ", jet " + str(m.max_speed()) + " m/s");
  wx.assert_close(sim_center, pred, 0.03);
}
wx.save_text("data/adjustment_width.csv", rows);
end _dsl_
savedsl(sim, "data/adjustment_width-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/adjustment_width-sim.dslb;
assert(r.code == 0, r.stdout + r.stderr);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/adjustment_width.png", 900, 560);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set key below");
plot.cmd("set title 'Geostrophic adjustment of a 1 m ridge: what survives depends on its width vs the Rossby radius'");
plot.cmd("set xlabel 'ridge width L / L_d   (L_d = sqrt(g H) / f = 990 km)'; set ylabel 'fraction kept'; set logscale x; set xrange [0.1:5]; set yrange [0:1.05]; set ytics 0.2");
plot.cmd("set xtics (0.25, 0.5, 1, 2, 4); set xrange [0.2:5]");
plot.cmd("plot 'data/adjustment_width.csv' u 1:3 w l lw 2.5 lc rgb '#1f77b4' t 'centre height, potential-vorticity prediction h_n / (1 + k_n^2 L_d^2)', '' u 1:2 w p pt 7 ps 1.8 lc rgb '#d62728' t 'centre height, lmweather (time mean over 10 inertial periods)', '' u 1:4 w lp lw 2 dt 2 pt 5 lc rgb '#2ca02c' t 'energy left in the balanced state (rest radiates as inertia-gravity waves)'");
plot.close();
end _dsl_
savedsl(draw, "data/adjustment_width-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/adjustment_width-draw.dslb;
assert(r.code == 0, r.stdout + r.stderr);
println("wrote images/adjustment_width.png");
